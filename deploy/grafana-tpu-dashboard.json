{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "name": "TPU-CognitionMesh Observability",
  "panelTolerant": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "TPU HBM Memory Usage (Bytes)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-tpu" },
          "expr": "tpu_hbm_used_bytes / (1024 * 1024 * 1024)",
          "legendFormat": "Pod {{pod_name}} - Chip {{chip_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "TPU Vector Core / MXU Utilization (%)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-tpu" },
          "expr": "rate(tpu_mxu_active_cycles_total[1m]) * 100",
          "legendFormat": "MXU Core {{core_id}} - Pod {{pod_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "id": 3,
      "title": "Inter-Chip Interconnect (ICI) Network Bandwidth",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-tpu" },
          "expr": "rate(tpu_ici_transmitted_bytes_total[1m])",
          "legendFormat": "ICI TX - {{pod_name}}"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-tpu" },
          "expr": "rate(tpu_ici_received_bytes_total[1m])",
          "legendFormat": "ICI RX - {{pod_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": { "mode": "palette-classic" }
        }
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["tpu", "maxtext", "vllm", "sglang", "cognition-mesh"],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "TPU-CognitionMesh Pod Telemetry",
  "version": 1
}